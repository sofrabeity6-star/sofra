# انسخ هذا الملف إلى .env للتشغيل المحلي. على Render ضع نفس القيم في Environment.

# ===== قاعدة البيانات (Supabase ← Project Settings ← Database ← Connection string ← Transaction pooler) =====
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ===== تخزين الصور (Supabase ← Project Settings ← API) =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== الأمان =====
# سر توقيع الجلسات: 32 حرفاً عشوائياً على الأقل
JWT_SECRET=
# مفتاح مهمة التجهيز الدورية /api/cron/tick (أي نص عشوائي طويل)
CRON_SECRET=

# ===== حساب المدير الأول (يُنشأ عند أول تشغيل فقط إذا لم يوجد مدير) =====
ADMIN_NAME=مدير المطبخ
ADMIN_PHONE=
ADMIN_PASSWORD=

# ===== اختياري =====
# إشعارات الموبايل عبر Expo Push
EXPO_ACCESS_TOKEN=
# NODE_ENV=production
# TRUST_PROXY=1
# PORT=3000
